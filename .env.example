CYBERSHIELD_ENV=production

# AI provider:
# auto = OpenRouter when an API key exists, otherwise local Ollama.
# openrouter = force OpenRouter.
# ollama = force local AI.
CYBERSHIELD_AI_PROVIDER=auto

# OpenRouter. "openrouter/free" automatically routes to an available free model.
# You can replace it with any model ID from OpenRouter.
CYBERSHIELD_AI_MODEL=openrouter/free
CYBERSHIELD_AI_BASE_URL=https://openrouter.ai/api/v1
CYBERSHIELD_AI_API_KEY=

# Optional aliases accepted by the provider:
# OPENROUTER_API_KEY=

CYBERSHIELD_AI_TIMEOUT=30
CYBERSHIELD_APP_NAME=CyberShield
# Optional: public project URL sent to OpenRouter as HTTP-Referer.
# CYBERSHIELD_APP_URL=

# Local/offline fallback (Ollama):
# CYBERSHIELD_AI_MODEL=llama3.1:8b
# CYBERSHIELD_AI_PROVIDER=ollama

# Optional: require a shared-secret token on every /api/* request except
# /api/health. Leave unset for local-only use (127.0.0.1).
# CYBERSHIELD_API_TOKEN=

# Real phishing reputation (optional). Get a Google Safe Browsing API key.
# Without this key CyberShield uses its local phishing heuristics only.
CYBERSHIELD_GOOGLE_SAFE_BROWSING_KEY=

# Protection tuning
CYBERSHIELD_PROCESS_GUARD=on
CYBERSHIELD_REALTIME_FILES=on

# Optional hash/URL reputation enrichment. Hashes/URLs are queried; files are not uploaded by CyberShield.
CYBERSHIELD_VIRUSTOTAL_API_KEY=
